#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* countAndSay(int n) {
    char *curr = (char *)malloc(5000);
    strcpy(curr, "1");

    for (int i = 2; i <= n; i++) {
        char *next = (char *)malloc(5000);
        int k = 0;
        int len = strlen(curr);

        for (int j = 0; j < len; ) {
            int count = 1;
            while (j + count < len && curr[j] == curr[j + count]) {
                count++;
            }

            k += sprintf(next + k, "%d%c", count, curr[j]);
            j += count;
        }

        free(curr);
        curr = next;
    }

    return curr;
}
