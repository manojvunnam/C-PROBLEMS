/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned in *returnColumnSizes.
 * Note: Both returned array and *returnColumnSizes must be malloced.
 */

void backtrack(int *nums, int n, int *used, int *current,
               int **result, int *returnSize, int *returnColumnSizes) {

    if (*returnSize >= 720)
        return;

    int count = 0;

    for (int i = 0; i < n; i++) {
        if (used[i])
            count++;
    }

    if (count == n) {
        result[*returnSize] = malloc(n * sizeof(int));

        for (int i = 0; i < n; i++) {
            result[*returnSize][i] = current[i];
        }

        returnColumnSizes[*returnSize] = n;
        (*returnSize)++;
        return;
    }

    for (int i = 0; i < n; i++) {
        if (!used[i]) {
            used[i] = 1;
            current[count] = nums[i];

            backtrack(nums, n, used, current,
                      result, returnSize, returnColumnSizes);

            used[i] = 0;
        }
    }
}

int** permute(int* nums, int numsSize, int* returnSize,
              int** returnColumnSizes) {

    int total = 1;

    for (int i = 1; i <= numsSize; i++) {
        total *= i;
    }

    int **result = malloc(total * sizeof(int *));
    *returnColumnSizes = malloc(total * sizeof(int));

    int *used = calloc(numsSize, sizeof(int));
    int *current = malloc(numsSize * sizeof(int));

    *returnSize = 0;

    backtrack(nums, numsSize, used, current,
              result, returnSize, *returnColumnSizes);

    free(used);
    free(current);

    return result;
}
